  )
  log(`Architect revised ImplementationPlan. Complexity: ${implPlan.complexity}`)
} else {
  log('Nag: ImplementationPlan passed.')
}

{{#IF INCLUDE_RTE}}
// With the RTE the plan is saved so later invocations can continue without
// re-planning; the branch for each PR is created per unit, not here.
if (rte) {
  const st = await rteStart(taskSpec, designSpec, implPlan)
  if (PLAN_APPROVAL && !args?.plan_approved) {
    log('*** PAUSED — Human approval required before the plan is split into PRs. ***')
    return {
      paused: true,
      stage: 'plan-approval',
      rte: true,
      task_spec: taskSpec,
      design_spec: designSpec,
      implementation_plan: implPlan,
      next: 'Approve: re-run with rte: true and plan_approved: true. The RTE then splits the plan into PRs and pauses again for you to approve the breakdown.',
    }
  }
  return await rteBreakdownStage(st, null)
}
{{/IF}}

// Human approval gate
if (PLAN_APPROVAL && !args?.plan_approved) {
  log('*** PAUSED — Human approval required before implementation begins. ***')
  log('Review the ImplementationPlan above, then re-run this workflow to continue.')
  return {
    paused: true,
    stage: 'plan-approval',
    task_spec: taskSpec,
    design_spec: designSpec,
    implementation_plan: implPlan,
  }
}


// ── Steps 5–8: implement, review, test, open the PR ──────────────────────────
return await runUnit(null, {
  ticket: taskSpec,
  taskSpecText: JSON.stringify(taskSpec, null, 2),
  implPlanText: JSON.stringify(implPlan, null, 2),
  designBlock: designSpec ? `DesignSpec:\n${JSON.stringify(designSpec, null, 2)}` : '',
  decisions: args?.decisions,
  with_tests,
})

// ─── Unit execution ──────────────────────────────────────────────────────────
// One unit of work becomes one PR: Developer → Reviewer (retry loop) → Tester →
// Study Guide in parallel with DevOps → PR review loop. Without the RTE the whole
// plan is a single unit (unit === null), which is the original single-PR flow.
// The body is deliberately NOT indented: it holds multi-line prompt template
// literals whose text must stay byte-identical to that flow.

async function runUnit(unit, ctx) {
const branch = unit ? unit.branch : ctx.ticket.branch
const notes = unit ? unitNotes(unit, ctx) : { preamble: '', dev: '', review: '', devops: '', guide: '' }
const devNote = notes.dev
const reviewNote = notes.review
const devopsNote = notes.devops
const guideNote = notes.guide
const U = unit ? (prompt, opts) => run(notes.preamble + prompt, opts) : run
const halt = (obj) => (unit ? { ...obj, unit_id: unit.id } : obj)

{{#IF INCLUDE_RTE}}
if (unit) {
  phase('Implementation')
  log(`Preparing branch ${unit.branch} for ${unit.id}...`)
  const setup = await run(
    unit.worktree
      ? `Prepare an isolated git worktree and branch for one pull request. Several PRs are built in parallel, so do not touch the main checkout.

Run, in the project's repository:
  git fetch origin
  git worktree add ${unit.worktree} -b ${unit.branch} origin/{{PR_TARGET_BRANCH}}
  cd ${unit.worktree} && git push -u origin ${unit.branch}

If the branch already exists (a retry), do not recreate or reset it: run "git worktree add ${unit.worktree} ${unit.branch}" instead. If the worktree directory already exists, reuse it.
If the repository is missing, is not a git repository, or has no remote, create nothing and report ok=false with the error.`
      : `Prepare the git branch for one pull request.

Run, in the project's repository:
  git checkout {{PR_TARGET_BRANCH}} && git pull
  git checkout -b ${unit.branch}
  git push -u origin ${unit.branch}

If the branch already exists locally or on origin (a retry), check it out and do not recreate or reset it.
If the repository is missing, is not a git repository, or has no remote, create nothing and report ok=false with the error.`,
    { label: `branch-${unit.id}`, phase: 'Implementation',
      schema: { type: 'object', required: ['ok'], properties: { ok: { type: 'boolean' }, error: { type: 'string' } } } }
  )
  if (!setup || !setup.ok) {
    log(`HALTED — could not prepare branch for ${unit.id}: ${setup?.error || 'unknown error'}`)
    return halt({ halted: true, stage: 'unit-branch', reason: setup?.error })
  }
}

{{/IF}}
// ── Step 5: Developer → Reviewer loop ────────────────────────────────────────
phase('Implementation')

let implResult = null
let reviewResult = null
let internalAttempts = 0

while (internalAttempts < MAX_INTERNAL_RETRIES) {
  log(`Developer: implementing (attempt ${internalAttempts + 1}/${MAX_INTERNAL_RETRIES})...`)
  implResult = await U(
    `You are the Developer agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationPlan:
${ctx.implPlanText}

${ctx.designBlock}
${ctx.decisions ? `\nHuman decisions made at plan approval (these override the plan where they conflict):\n${ctx.decisions}` : ''}
${reviewResult ? `\nPrevious ReviewResult (address these findings):\n${JSON.stringify(reviewResult, null, 2)}` : ''}

${devNote}Implement the plan, run tests, and produce an ImplementationResult.`,
    { agentType: 'implementer', schema: IMPL_RESULT_SCHEMA, phase: 'Implementation' }
  )

  if (!implResult || implResult.status === 'blocked') {
    log(`HALTED — Developer blocked: ${implResult?.blockers?.join(', ')}`)
    return halt({ halted: true, stage: 'developer', blockers: implResult?.blockers })
  }

  phase('Review')
  log('Reviewer: verifying implementation...')
  reviewResult = await U(
    `You are the Reviewer agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationResult:
${JSON.stringify(implResult, null, 2)}
${ctx.decisions ? `\nHuman decisions made at plan approval (these override the TaskSpec acceptance criteria where they conflict; do not flag deviations they authorise):\n${ctx.decisions}` : ''}

${reviewNote}Run your configured review skills and produce a ReviewResult.`,
    { agentType: 'reviewer', schema: REVIEW_RESULT_SCHEMA, phase: 'Review' }
  )

  if (reviewResult.status === 'approved') {
    log('Reviewer approved the implementation.')
    break
  }

  internalAttempts++
  log(`Reviewer requested changes (attempt ${internalAttempts}/${MAX_INTERNAL_RETRIES}).`)
  phase('Implementation')
}

if (reviewResult.status !== 'approved') {
  log(`HALTED — Reviewer still requesting changes after ${MAX_INTERNAL_RETRIES} attempts.`)
  return halt({ halted: true, stage: 'review-loop', review_result: reviewResult })
}

// ── Step 6: Tester (optional) ─────────────────────────────────────────────────
let testResult = null

if (HAS_E2E && ctx.with_tests) {
  phase('Testing')
  log('Tester: writing and running e2e tests...')
  testResult = await U(
    `You are the Tester agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationResult:
${JSON.stringify(implResult, null, 2)}

ReviewResult (must be approved before you run):
${JSON.stringify(reviewResult, null, 2)}

${ctx.designBlock}

${reviewNote}Write e2e tests for each AC criterion, run them, and report a TestResult.`,
    { agentType: 'tester', schema: TEST_RESULT_SCHEMA, phase: 'Testing' }
  )

  if (testResult.status === 'blocked') {
    log(`HALTED — Tester blocked: ${testResult.blockers?.join(', ')}`)
    return halt({ halted: true, stage: 'tester', blockers: testResult.blockers })
  }
}

// ── Local-only: no remote, so no PR. Stop at a reviewed local branch. ────────
if (local_only) {
  log(`SUCCESS (local-only) — branch ${branch} is implemented and reviewed. No PR created. Human merge required.`)
  return {
    ticket_id: ctx.ticket.ticket_id,
    branch: branch,
    status: 'local_ready',
    files_changed: implResult.files_changed,
    review_status: reviewResult.status,
    test_result: testResult,
    message: 'Local-only run: no PR created. Review the branch and merge to main yourself.',
  }
}

// ── Step 7–8: DevOps + PR review loop ────────────────────────────────────────
phase('Deploy')
log('DevOps: creating PR and monitoring CI...')

let deployStatus = null
let prReviewCycles = 0

// Initial PR creation — Study Guide runs in parallel when configured
{{#IF INCLUDE_STUDY_GUIDE}}
log('Study Guide running in parallel with PR creation...')
const _initResults = await parallel([
  () => run(
    `You are the Study Guide agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationPlan:
${ctx.implPlanText}

ImplementationResult:
${JSON.stringify(implResult, null, 2)}

${guideNote}Review the Architect's plan and the Developer's implementation. Surface intermediate-to-advanced patterns as study entries and write the context file.`,
    { agentType: 'study-guide', label: 'study-guide', phase: 'Review' }
  ),
  () => run(
    `You are the DevOps agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationResult:
${JSON.stringify(implResult, null, 2)}

ReviewResult:
${JSON.stringify(reviewResult, null, 2)}

${testResult ? `TestResult:\n${JSON.stringify(testResult, null, 2)}` : ''}

${devopsNote}Create the PR, then monitor CI and human review comments. Produce a DeployStatus.`,
    { agentType: 'devops', schema: DEPLOY_STATUS_SCHEMA, phase: 'Deploy' }
  ),
])
deployStatus = _initResults[1]
{{/IF}}

// When Study Guide is not configured, create PR directly
if (!deployStatus) {
  deployStatus = await U(
    `You are the DevOps agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationResult:
${JSON.stringify(implResult, null, 2)}

ReviewResult:
${JSON.stringify(reviewResult, null, 2)}

${testResult ? `TestResult:\n${JSON.stringify(testResult, null, 2)}` : ''}

${devopsNote}Create the PR, then monitor CI and human review comments. Produce a DeployStatus.`,
    { agentType: 'devops', schema: DEPLOY_STATUS_SCHEMA, phase: 'Deploy' }
  )
}

// Process deployStatus and handle PR review cycles
while (true) {
  if (deployStatus.status === 'ready') {
    log(`SUCCESS — PR is ready: ${deployStatus.pr_url}`)
    log('CI is green. Awaiting human merge. Workflow complete.')
    {{#IF NOTIFICATION_MCP_ID}}
    // Notify via {{NOTIFICATION_MCP}}
    await U(
      `Send a notification via {{NOTIFICATION_MCP}} that the PR for "${ctx.ticket.ticket_id}: ${ctx.ticket.title}" is ready for merge.
PR URL: ${deployStatus.pr_url}
Use {{NOTIFICATION_MCP_ID}}* tools.`,
      { label: 'notify', phase: 'Deploy' }
    )
    {{/IF}}
    break
  }

  if (deployStatus.status === 'ci_failing') {
    log(`HALTED — CI is failing: ${deployStatus.ci_failures?.join(', ')}`)
    return halt({ halted: true, stage: 'devops', ci_failures: deployStatus.ci_failures, pr_url: deployStatus.pr_url })
  }

  if (deployStatus.status === 'blocked') {
    log(`HALTED — DevOps blocked: ${deployStatus.notes}`)
    return halt({ halted: true, stage: 'devops', notes: deployStatus.notes })
  }

  // changes_requested — enter PR review comment loop
  if (prReviewCycles >= MAX_PR_REVIEW_CYCLES) {
    log(`HALTED — Exceeded max PR review cycles (${MAX_PR_REVIEW_CYCLES}).`)
    return halt({ halted: true, stage: 'pr-review-loop', pr_url: deployStatus.pr_url })
  }

  prReviewCycles++
  log(`PR review cycle ${prReviewCycles}/${MAX_PR_REVIEW_CYCLES}: Developer evaluating comments...`)
  phase('Implementation')

  // Developer evaluates PR review comments
  implResult = await U(
    `You are the Developer agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationPlan:
${ctx.implPlanText}

${devNote}You received human PR review comments. Evaluate each one and produce an ImplementationResult.

Review comments:
${JSON.stringify(deployStatus.review_comments, null, 2)}`,
    { agentType: 'implementer', schema: IMPL_RESULT_SCHEMA, phase: 'Implementation' }
  )

  // Handle any escalations
  if (implResult.pr_comment_dispositions) {
    for (const d of implResult.pr_comment_dispositions) {
      if (d.disposition === 'needs_context' && d.escalate_to === 'product_owner') {
        log(`Escalating comment ${d.comment_id} to Product Owner for AC clarification...`)
        await U(
          `You are the Product Owner agent for {{PROJECT_NAME}}.

A Developer needs clarification on a PR review comment.

TaskSpec:
${ctx.taskSpecText}

Comment: ${d.notes}

Provide a clear answer that the Developer can act on.`,
          { agentType: 'product-owner', label: 'po-consult', phase: 'Implementation' }
        )
        log(`PO clarification received. Returning to Developer.`)
      } else if (d.disposition === 'needs_context' && d.escalate_to === 'architect') {
        log(`Escalating comment ${d.comment_id} to Architect for implementation guidance...`)
        await U(
          `You are the Architect agent for {{PROJECT_NAME}}.

A Developer needs clarification on a PR review comment about implementation approach.

TaskSpec:
${ctx.taskSpecText}

ImplementationPlan:
${ctx.implPlanText}

Comment: ${d.notes}

Provide a clear answer the Developer can act on.`,
          { agentType: 'architect', label: 'architect-consult', phase: 'Implementation' }
        )
        log(`Architect clarification received. Returning to Developer.`)
      }
    }
  }

  // Re-verify before pushing
  if (implResult.trigger_review) {
    phase('Review')
    log('Reviewer: re-verifying after PR comment fixes...')
    reviewResult = await U(
      `You are the Reviewer agent for {{PROJECT_NAME}}.

TaskSpec:
${ctx.taskSpecText}

ImplementationResult (after PR comment fixes):
${JSON.stringify(implResult, null, 2)}

${reviewNote}Run a focused re-review and produce a ReviewResult.`,
      { agentType: 'reviewer', schema: REVIEW_RESULT_SCHEMA, phase: 'Review' }
    )

    if (reviewResult.status === 'changes_requested') {
      internalAttempts++
      if (internalAttempts >= MAX_INTERNAL_RETRIES) {
        log(`HALTED — Reviewer still requesting changes after ${internalAttempts} total attempts.`)
        return halt({ halted: true, stage: 'review-loop-pr', review_result: reviewResult })
      }
    }
  }

  // Poll for updated CI status and review comments
  phase('Deploy')
  deployStatus = await U(
    `You are the DevOps agent for {{PROJECT_NAME}}.

