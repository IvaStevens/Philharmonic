}

// ── Step 4: Architect ─────────────────────────────────────────────────────────
phase('Architecture')
log('Architect: analysing codebase and producing ImplementationPlan...')

let implPlan = await run(
  `You are the Architect agent for {{PROJECT_NAME}}.

TaskSpec:
${JSON.stringify(taskSpec, null, 2)}

${designSpec ? `DesignSpec:\n${JSON.stringify(designSpec, null, 2)}` : 'DesignSpec: null (no design tool configured)'}

Run your configured skills, write the context file, perform your three self-audit passes, then produce the ImplementationPlan.`,
  { agentType: 'architect', schema: IMPL_PLAN_SCHEMA, phase: 'Architecture' }
)

log(`ImplementationPlan produced. Complexity: ${implPlan.complexity}`)

// ── Nag: stress-test ImplementationPlan ──────────────────────────────────────
log('Nag: stress-testing ImplementationPlan...')
nagResult = await run(
