    ? `Create git branch "${taskSpec.branch}" from {{PR_TARGET_BRANCH}}. This repository is local-only (no remote) — do NOT pull or push.

Run:
  git checkout {{PR_TARGET_BRANCH}}
  git checkout -b ${taskSpec.branch}

If the directory is missing or is not a git repository, do not create anything — report ok=false with the error.`
    : `Create git branch "${taskSpec.branch}" from {{PR_TARGET_BRANCH}} and push it.

Run:
  git checkout {{PR_TARGET_BRANCH}} && git pull
  git checkout -b ${taskSpec.branch}
  git push -u origin ${taskSpec.branch}

If the directory is missing, is not a git repository, or has no remote, do not create anything — report ok=false with the error.`,
  { label: 'create-branch', phase: 'Requirements',
    schema: { type: 'object', required: ['ok'], properties: { ok: { type: 'boolean' }, error: { type: 'string' } } } }
)
if (!branchResult || !branchResult.ok) {
